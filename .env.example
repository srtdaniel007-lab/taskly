# ==========================================================
# TaskPulse / Trackly - Environment Configuration
# ==========================================================

# Application
PROJECT_NAME="TaskPulse"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
PORT=8000

# Security & Authentication
# Generate a strong key with: openssl rand -hex 32
SECRET_KEY="replace_with_a_super_secret_key_minimum_32_characters_long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# On Render, this is automatically provided as DATABASE_URL
# Supports postgres://, postgresql://, or postgresql+asyncpg://
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/taskpulse"
DB_ECHO=False

# SMTP Email Configuration (Optional - falls back to logging if not set)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@taskpulse.io"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="TaskPulse Notifications <notifications@taskpulse.io>"
SMTP_TLS=True

# Frontend / App Host URL for links in email notifications
APP_BASE_URL="http://localhost:8000"
